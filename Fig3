#!/usr/bin/env python3
"""
Figure 3. Change in fire-season burned area between 2001-2012 and 2013-2024
under CHD, heatwave-only, drought-only and non-extreme conditions.
"""

import os
from pathlib import Path

import matplotlib.patheffects as pe
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import xarray as xr

# ------------------------------------------------------------------
# Paths and settings
# ------------------------------------------------------------------
DATA_DIR = Path(os.environ.get("CHD_DATA_DIR", "data"))
OUT_DIR = Path(os.environ.get("CHD_OUT_DIR", "figures"))
OUT_DIR.mkdir(parents=True, exist_ok=True)

STATS_FILE = DATA_DIR / "chd_statistics_classdaynorm_per_year.nc"
META_CSV = DATA_DIR / "ecoregion_metadata.csv"
OUT_FIG = OUT_DIR / "fig3_ba_fold_change.png"
OUT_CSV = OUT_DIR / "fig3_ecoregion_fold_change.csv"

CROPLAND_COL = "cropland_dominated_fs_low_50pct"
EARLY_YEARS = np.arange(2001, 2013)
LATE_YEARS = np.arange(2013, 2025)
N_BOOT = 10000
SEED = 42
ALPHA = 0.05

MECH_VARS = {
    "ba_chd_yearly":           "CHD",
    "ba_heatwave_only_yearly": "HW-only",
    "ba_drought_only_yearly":  "DR-only",
    "ba_no_extremes_yearly":   "Non-extreme",
}
MECH_ORDER = ["CHD", "HW-only", "DR-only", "Non-extreme"]
COLORS_VEG = {"forest": "#2d7f2d", "nonforest": "#c66b2e"}
MECH_COLORS = {"Non-extreme": "#b0b0b0", "HW-only": "#fbb4ae",
               "DR-only": "#fb8072", "CHD": "k"}

plt.rcParams.update({
    "font.size": 11,
    "axes.labelsize": 13,
    "axes.titlesize": 13,
    "xtick.labelsize": 11,
    "ytick.labelsize": 11,
    "legend.fontsize": 11,
    "axes.linewidth": 1.2,
})

for f in (STATS_FILE, META_CSV):
    if not f.exists():
        raise FileNotFoundError(f"Missing input file: {f}")

# ------------------------------------------------------------------
# 1. Load annual burned area by class (dimensions: year, ecoregion)
# ------------------------------------------------------------------
load_vars = ["ba_total_fs_yearly", *MECH_VARS]
with xr.open_dataset(STATS_FILE) as ds:
    missing = [v for v in load_vars if v not in ds.data_vars]
    if missing:
        raise KeyError(f"Variables not found in NetCDF: {missing}")
    df = ds[load_vars].to_dataframe().reset_index()

df["year"] = pd.to_numeric(df["year"], errors="coerce")
df = df[df["year"].between(EARLY_YEARS[0], LATE_YEARS[-1])].copy()
df["year"] = df["year"].astype(int)

# Consistency check: the four classes should add up to total fire-season burned area.
resid = (df["ba_total_fs_yearly"]
         - df[list(MECH_VARS)].sum(axis=1, min_count=1)).abs()
scale = df["ba_total_fs_yearly"].abs().max()
print(f"Max |total - sum of classes| = {resid.max():.4g} "
      f"({100 * resid.max() / scale:.2g}% of the largest annual total)")

# ------------------------------------------------------------------
# 2. Metadata and cropland filter
# ------------------------------------------------------------------
meta_cols = ["ecoregion", "biome_name", "forest_class", CROPLAND_COL]
meta = pd.read_csv(META_CSV)
missing_meta = [c for c in meta_cols if c not in meta.columns]
if missing_meta:
    raise KeyError(f"Metadata CSV is missing columns: {missing_meta}")
meta = meta[meta_cols].drop_duplicates(subset="ecoregion")

df = df.merge(meta, on="ecoregion", how="inner", validate="many_to_one")
df = df[df[CROPLAND_COL] == 0].copy()
df["veg_type"] = np.where(df["forest_class"].astype(str).str.strip() == "Forest",
                          "forest", "nonforest")
df = df.rename(columns={"biome_name": "biome"})
print(f"Ecoregions after cropland filter: {df['ecoregion'].nunique()}")

# ------------------------------------------------------------------
# 3. Ecoregion fold change, late / early
# ------------------------------------------------------------------
df["period"] = np.where(df["year"].isin(EARLY_YEARS), "early", "late")
period_sums = (df.groupby(["ecoregion", "biome", "veg_type", "period"], dropna=False)
                 [list(MECH_VARS)].sum()
                 .unstack("period"))

rows = []
for (eco, biome, veg), r in period_sums.iterrows():
    for var, mech in MECH_VARS.items():
        early, late = r[(var, "early")], r[(var, "late")]
        fold = late / early if np.isfinite(early) and early > 0 else np.nan
        rows.append({"ecoregion": eco, "biome": biome, "veg_type": veg,
                     "mechanism": mech, "early_ba": early, "late_ba": late,
                     "ratio_late_over_early": fold})
eco_fold = pd.DataFrame(rows)
eco_fold.to_csv(OUT_CSV, index=False)
print(f"Saved ecoregion fold-change table: {OUT_CSV}")

print("\nEcoregions with undefined fold change (zero early-period burned area):")
for veg in ["forest", "nonforest"]:
    for mech in MECH_ORDER:
        sub = eco_fold[(eco_fold["veg_type"] == veg) & (eco_fold["mechanism"] == mech)]
        print(f"  {veg:<9} {mech:<11} {sub['ratio_late_over_early'].isna().sum():>4} "
              f"of {len(sub)} excluded")


def bootstrap_median_vs_one(values, n_boot=N_BOOT, seed=SEED):
    """One-sample bootstrap of the median fold change; p = P(boot median <= 1)."""
    v = np.asarray(values, dtype=float)
    v = v[np.isfinite(v)]
    if v.size == 0:
        return None
    rng = np.random.default_rng(seed)
    idx = np.arange(v.size)
    boot = np.empty(n_boot)
    for b in range(n_boot):
        boot[b] = np.median(v[rng.choice(idx, size=v.size, replace=True)])
    ci_low, ci_high = np.percentile(boot, [2.5, 97.5])
    return {"obs": float(np.median(v)), "ci_low": ci_low, "ci_high": ci_high,
            "p_le_one": float((boot <= 1.0).mean()), "n": v.size}


def bootstrap_median_diff(x, y, n_boot=N_BOOT, seed=SEED):
    """Bootstrap of median(x) - median(y), x and y resampled independently."""
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    x, y = x[np.isfinite(x)], y[np.isfinite(y)]
    if x.size == 0 or y.size == 0:
        return None
    rng = np.random.default_rng(seed)
    ix, iy = np.arange(x.size), np.arange(y.size)
    boot = np.empty(n_boot)
    for b in range(n_boot):
        rx = rng.choice(ix, size=x.size, replace=True)
        ry = rng.choice(iy, size=y.size, replace=True)
        boot[b] = np.median(x[rx]) - np.median(y[ry])
    ci_low, ci_high = np.percentile(boot, [2.5, 97.5])
    p_one = float((boot <= 0).mean())
    p_two = min(1.0, 2 * min(p_one, float((boot >= 0).mean())))
    return {"obs": float(np.median(x) - np.median(y)), "ci_low": ci_low,
            "ci_high": ci_high, "p_one": p_one, "p_two": p_two}


# ------------------------------------------------------------------
# 4. Panel A: forest vs. non-forest
# ------------------------------------------------------------------
print("\n=== Panel A: median fold change vs. 1 (bootstrap) ===")
forest_vals, nonforest_vals = [], []
fold_sig = {"forest": {}, "nonforest": {}}
for mech in MECH_ORDER:
    for veg, store in [("forest", forest_vals), ("nonforest", nonforest_vals)]:
        vals = eco_fold.loc[(eco_fold["veg_type"] == veg)
                            & (eco_fold["mechanism"] == mech),
                            "ratio_late_over_early"].dropna().to_numpy()
        store.append(np.median(vals) if vals.size else np.nan)
        res = bootstrap_median_vs_one(vals)
        fold_sig[veg][mech] = res
        if res is None:
            continue
        verdict = ("significant increase" if res["p_le_one"] < ALPHA else
                   "significant decrease" if res["p_le_one"] > 1 - ALPHA else
                   "not significant")
        print(f"  {veg:<9} {mech:<11} n = {res['n']:>3}  median = {res['obs']:.3f}  "
              f"95% CI [{res['ci_low']:.3f}, {res['ci_high']:.3f}]  "
              f"P(boot <= 1) = {res['p_le_one']:.4f}  ({verdict})")

# ------------------------------------------------------------------
# 5. Panel B: biome medians and CHD vs. other classes
# ------------------------------------------------------------------
agg_piv = (eco_fold.groupby(["biome", "mechanism"])["ratio_late_over_early"]
                   .median()
                   .unstack("mechanism")
                   .reindex(columns=MECH_ORDER)
                   .sort_values("CHD", ascending=False))

print("\n=== Panel B: median(CHD fold) - median(other fold), by biome (bootstrap) ===")
per_biome_sig = {}
for biome in agg_piv.index:
    sub = eco_fold[eco_fold["biome"] == biome]
    chd_vals = sub.loc[sub["mechanism"] == "CHD", "ratio_late_over_early"].to_numpy()
    per_biome_sig[biome] = {}
    for other in ["HW-only", "DR-only", "Non-extreme"]:
        oth_vals = sub.loc[sub["mechanism"] == other, "ratio_late_over_early"].to_numpy()
        res = bootstrap_median_diff(chd_vals, oth_vals)
        if res is None:
            print(f"  {biome[:45]:<45} CHD vs {other:<11} insufficient data")
            continue
        per_biome_sig[biome][other] = res["p_one"]
        print(f"  {biome[:45]:<45} CHD vs {other:<11} diff = {res['obs']:7.2f}  "
              f"95% CI [{res['ci_low']:.2f}, {res['ci_high']:.2f}]  "
              f"p one-sided = {res['p_one']:.4f}  p two-sided = {res['p_two']:.4f}")

# ------------------------------------------------------------------
# 6. Figure
# ------------------------------------------------------------------
fig, (ax_top, ax_bot) = plt.subplots(2, 1, figsize=(11, 9),
                                     gridspec_kw={"height_ratios": [1, 2]})

# Panel A
x = np.arange(len(MECH_ORDER))
width = 0.36
bars_f = ax_top.bar(x - width / 2, forest_vals, width, label="Forest",
                    color=COLORS_VEG["forest"])
bars_nf = ax_top.bar(x + width / 2, nonforest_vals, width, label="Non-forest",
                     color=COLORS_VEG["nonforest"])

ax_top.set_xticks(x)
ax_top.set_xticklabels(MECH_ORDER, fontsize=14)
ax_top.set_xlim(-0.42, x[-1] + 0.42)
ax_top.set_ylabel("BA ratio\n(2013–2024 / 2001–2012)", fontsize=14)
ax_top.set_title("(a) Forest vs. Non-forest", fontsize=16)
ax_top.axhline(1.0, color="grey", linewidth=0.7, linestyle="-.")

ymax_top = float(np.nanmax(forest_vals + nonforest_vals))
ax_top.set_ylim(0, max(4.0, ymax_top * 1.1))

for i, mech in enumerate(MECH_ORDER):
    for veg, bars in [("forest", bars_f), ("nonforest", bars_nf)]:
        res = fold_sig[veg].get(mech)
        if res is None or ALPHA <= res["p_le_one"] <= 1 - ALPHA:
            continue
        bar = bars[i]
        ax_top.text(bar.get_x() + bar.get_width() / 2.0,
                    bar.get_height() - 0.04 * ymax_top, "*",
                    ha="center", va="bottom", fontsize=16, fontweight="bold",
                    color=COLORS_VEG[veg],
                    path_effects=[pe.withStroke(linewidth=2, foreground="white")])

leg = ax_top.legend(frameon=True, loc="upper right", fontsize=11)
leg.get_frame().set_edgecolor("lightgray")
leg.get_frame().set_linewidth(0.8)

# Panel B
mech_order_plot = ["Non-extreme", "HW-only", "DR-only", "CHD"]
biome_labels = agg_piv.index
y = np.arange(len(biome_labels))
bar_height = 0.18
offsets = {"Non-extreme": -1.5 * bar_height, "HW-only": -0.5 * bar_height,
           "DR-only": 0.5 * bar_height, "CHD": 1.5 * bar_height}
for mech in mech_order_plot:
    ax_bot.barh(y + offsets[mech], agg_piv[mech].to_numpy(), height=bar_height,
                color=MECH_COLORS[mech], label=mech, edgecolor="none")

ax_bot.set_yticks(y)
ax_bot.set_yticklabels(biome_labels, fontsize=11)
ax_bot.set_ylim(-0.5, len(biome_labels) - 0.5)
ax_bot.invert_yaxis()
ax_bot.set_xlabel("BA ratio (2013–2024 / 2001–2012)", fontsize=14)
ax_bot.set_title("(b) Biomes", fontsize=16)

xmax = float(np.nanmax(agg_piv.to_numpy()))
ax_bot.set_xlim(0, max(9.0, xmax * 1.1))
ax_bot.axvline(1.0, color="grey", linewidth=0.7, linestyle="-.")

star_order = ["DR-only", "HW-only", "Non-extreme"]
star_dx, star_gap = 0.015 * xmax, 0.035 * xmax
for i, biome in enumerate(biome_labels):
    x_chd = agg_piv.loc[biome, "CHD"]
    if not np.isfinite(x_chd):
        continue
    y_chd = y[i] + offsets["CHD"] + bar_height / 2.0 + 0.065
    for k, other in enumerate(star_order):
        p = per_biome_sig.get(biome, {}).get(other)
        if p is None or p >= ALPHA:
            continue
        ax_bot.text(x_chd + star_dx + k * star_gap, y_chd, "*",
                    color=MECH_COLORS[other], va="center", ha="left",
                    fontsize=16, fontweight="bold")

handles, labels = ax_bot.get_legend_handles_labels()
by_label = dict(zip(labels, handles))
ax_bot.legend([by_label[m] for m in mech_order_plot], mech_order_plot,
              frameon=False, loc="lower right", fontsize=11)

# Black frame on all four sides of both panels.
for ax, lw in [(ax_top, 1.5), (ax_bot, 2.0)]:
    for spine in ax.spines.values():
        spine.set_visible(True)
        spine.set_color("black")
        spine.set_linewidth(lw)

plt.tight_layout()
plt.subplots_adjust(hspace=0.17)
plt.savefig(OUT_FIG, dpi=600, bbox_inches="tight")
print(f"\nSaved: {OUT_FIG}")
plt.show()
plt.close(fig)
